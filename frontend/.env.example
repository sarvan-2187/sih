# Copy this file to .env (never commit the real .env). Vite only exposes
# vars prefixed VITE_ to client code — anything else here would be a no-op.

# --- Backend API (src/lib/apiClient.ts and every src/api/*.ts file) ---
# Falls back to http://127.0.0.1:8000 in code if unset.
VITE_API_URL=http://127.0.0.1:8000

# --- Firebase Auth (src/firebase.ts) ---
VITE_FIREBASE_API_KEY=<your-firebase-api-key>
VITE_FIREBASE_AUTH_DOMAIN=<your-project>.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=<your-firebase-project-id>
VITE_FIREBASE_STORAGE_BUCKET=<your-project>.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=<your-messaging-sender-id>
VITE_FIREBASE_APP_ID=<your-firebase-app-id>
VITE_FIREBASE_MEASUREMENT_ID=<your-firebase-measurement-id>

# --- qBook (src/modules/qbook/hooks/useQBookKernelSocket.ts) — WebSocket
# straight to notebook_service, never proxied through the backend API.
# Defaults to ws://127.0.0.1:8081 in code if unset, matching
# notebook_service's own default PORT. ---
VITE_QBOOK_SERVICE_URL=ws://127.0.0.1:8081

# TEMP(QuantLMS): 1 = purple QuantLMS landing page, anything else = original landing
QUANTLMS_LANDING_PAGE=0
