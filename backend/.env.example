# Copy this file to .env (never commit the real .env).

# --- Deployment environment (app_env.py) ---
# Leave UNSET locally to get every QRoute provider/device. Set to "production"
# on the deployed host to hide what can't work there: the IQM provider (its
# service isn't deployed) and qBraid's real QPUs (account has no funded
# hardware credits) — see services/quantum_providers/__init__.py.
# APP_ENV=production

# --- MongoDB ---
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# --- Firebase Admin (auth.py) ---
FIREBASE_SERVICE_ACCOUNT_PATH=<path-to-firebase-service-account.json>

# --- Backblaze B2 (storage_service.py) — main resources bucket ---
# NOTE: routers/notes.py's attachment upload reads B2_ENDPOINT_URL, not
# B2_ENDPOINT like everything else (storage_service.py/live_service.py/
# set_cors.py) — a pre-existing naming inconsistency, not fixed here. Set
# both to the same value if you need note attachments to actually use B2
# rather than notes.py's non-B2 fallback path.
B2_ENDPOINT=https://s3.<region>.backblazeb2.com
# B2_ENDPOINT_URL=https://s3.<region>.backblazeb2.com
B2_KEY_ID=<your-b2-application-key-id>
B2_APPLICATION_KEY=<your-b2-application-key>
B2_BUCKET_NAME=qrious-resources-bucket

# --- Backblaze B2 (storage_service.py) — separate bucket for qBook datasets ---
B2_DATASETS_KEY_ID=<your-b2-application-key-id>
B2_DATASETS_APPLICATION_KEY=<your-b2-application-key>
B2_DATASETS_BUCKET_NAME=<your-b2-datasets-bucket-name>

# --- LiveKit (live_service.py / routers/live.py) — live session rooms + recording ---
LIVEKIT_URL=wss://<your-project>.livekit.cloud
LIVEKIT_API_KEY=<your-livekit-api-key>
LIVEKIT_API_SECRET=<your-livekit-api-secret>

# --- qstudio_service (Audio/Slides/Animation render pipeline). qStudio RAG
# (rag/, below) has no cross-service dependency of its own — it runs
# entirely inside backend/. ---
QSTUDIO_SERVICE_URL=http://localhost:8080
QSTUDIO_SERVICE_SECRET=<shared-random-secret-matching-qstudio_service/.env>

# --- notebook_service (qBook WS session token, HS256) ---
QBOOK_SERVICE_SECRET=<shared-random-secret-matching-notebook_service/.env>

# --- QRoute — real quantum hardware providers (services/quantum_providers/) ---
QBRAID_API_KEY=<your-qbraid-api-key>
QBRAID_DAILY_JOB_LIMIT=10
IONQ_API_KEY=<your-ionq-api-key>
QIBM_API_KEY=<your-ibm-quantum-api-key>
QIBM_INSTANCE_CRN=<your-ibm-quantum-instance-crn>

# --- iqm_service (QRoute's IQM Resonance adapter) ---
IQM_SERVICE_URL=http://127.0.0.1:8082
IQM_SERVICE_SECRET=<shared-random-secret-matching-iqm_service/.env>

# --- QRoute job-completion email (email_service.py, PLANS/qroute-email-notifications.md)
# Sends through an existing SMTP mailbox (e.g. Gmail with an app password) —
# no sending domain required. SMTP_FROM defaults to SMTP_USERNAME if unset. ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=<your-smtp-username-or-email>
SMTP_PASSWORD=<your-smtp-password-or-app-password>
# SMTP_FROM=<your-smtp-username-or-email>

# --- QRoute job-completion email — link back to the job page (qroute_notifier.py) ---
FRONTEND_BASE_URL=http://localhost:5173

# --- qStudio RAG (rag/, PLANS/qstudio-rag.md) — all optional, sane defaults
# in rag/config.py. Uncomment to override. ---
# RAG_CHUNK_TARGET_CHARS=900
# RAG_CHUNK_OVERLAP_CHARS=150
# RAG_PARENT_WINDOW_CHARS=2400
# RAG_RETRIEVAL_TOP_N=20
# RAG_RERANK_TOP_K=6
# RAG_RRF_K=60
# RAG_MIN_RELEVANCE_SCORE=-3.0
# RAG_CONTEXT_MAX_CHARS=6000
# RAG_RERANKER_ENABLED=true
# RAG_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# RAG_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# RAG_CHROMA_PERSIST_DIR=./qstudio_rag_chroma_db
# RAG_CONVERSATION_HISTORY_TURNS=4

# ============================================================================
# AI Gateway (ai/) — see docs/AI_GATEWAY.md for the full architecture.
# ============================================================================

# --- Provider credentials — every one is OPTIONAL. A provider with no key
# set is simply excluded from routing (logged, not a startup error) — see
# ai/registry.py. At least ONE must be set for any AI feature to work.
GROQ_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
NVIDIA_API_KEY=
KIMI_API_KEY=
Z_API_KEY=

# --- Per-provider overrides (optional) — base URL and default model id.
# Defaults live in ai/config.py; override here if a provider's catalog
# changes or you want a different default model without editing code.
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_MODEL=openai/gpt-oss-120b
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# GEMINI_MODEL=gemini-2.5-flash
# MISTRAL_BASE_URL=https://api.mistral.ai/v1
# MISTRAL_MODEL=mistral-small-latest
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
# KIMI_BASE_URL=https://api.moonshot.ai/v1
# KIMI_MODEL=kimi-k2-turbo-preview
# ZAI_BASE_URL=https://api.z.ai/api/paas/v4
# ZAI_MODEL=glm-4.6

# --- Routing policy ---
# AI_PROVIDER_PRIORITY=groq,gemini,mistral,nvidia,kimi,zai
# AI_GATEWAY_ENABLED=true

# --- Timeouts / retry / circuit breaker ---
# AI_REQUEST_TIMEOUT_SECONDS=30
# AI_CONNECT_TIMEOUT_SECONDS=10
# AI_MAX_PROVIDER_RETRIES=2
# AI_RETRY_BASE_DELAY_SECONDS=0.5
# AI_RETRY_MAX_DELAY_SECONDS=8
# AI_CIRCUIT_FAILURE_THRESHOLD=5
# AI_CIRCUIT_COOLDOWN_SECONDS=60
# AI_STRUCTURED_OUTPUT_REPAIR_RETRIES=1

# --- Application-level rate limiting (OFF by default) ---
# AI_RATE_LIMIT_ENABLED=false
# AI_RATE_LIMIT_PER_USER_PER_MINUTE=20
# AI_RATE_LIMIT_EXPENSIVE_PER_DAY=50

# --- Future: self-hosted vLLM (RunPod or similar) — ignored unless both
# VLLM_ENABLED=true AND VLLM_BASE_URL are set. No GPU/vLLM dependency is
# added to this application by enabling this — it's a plain HTTP client
# pointed at a vLLM server running elsewhere. ---
# VLLM_ENABLED=false
# VLLM_BASE_URL=
# VLLM_API_KEY=
# VLLM_MODEL=

# --- Future: Redis (distributed rate limiting / cache / circuit-breaker
# state across horizontally-scaled instances) — NOT required to run today;
# the MVP uses in-memory implementations of these interfaces. See
# docs/AI_GATEWAY.md's "Future Redis architecture" section. ---
# REDIS_ENABLED=false
# REDIS_URL=
