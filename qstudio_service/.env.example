# Copy this file to .env (never commit the real .env).

# --- MongoDB — same database as backend/ (writes back to qstudio_outputs /
# video_overviews as pipelines finish) ---
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# --- Backblaze B2 (storage_service.py) — same bucket backend/ uses ---
B2_ENDPOINT=https://s3.<region>.backblazeb2.com
B2_KEY_ID=<your-b2-application-key-id>
B2_APPLICATION_KEY=<your-b2-application-key>
B2_BUCKET_NAME=qrious-resources-bucket

# --- Trigger auth — backend/'s QSTUDIO_SERVICE_URL/QSTUDIO_SERVICE_SECRET
# must point at this service and share this exact secret. ---
QSTUDIO_SERVICE_URL=http://localhost:8080
QSTUDIO_SERVICE_SECRET=<shared-random-secret-matching-backend/.env>

# Platform-injected port convention (Render/Railway/etc — see Dockerfile's
# CMD `--port ${PORT:-8080}`); leave unset to use 8080 locally.
# PORT=8080

# ============================================================================
# AI Gateway (ai/) — independent copy of backend/ai/, same architecture, see
# docs/AI_GATEWAY.md. Used for storyboard/script generation (Audio Overview,
# Slides, Animation/Manim) — see PLANS/qstudio-animation.md.
# ============================================================================

# --- Provider credentials — every one is OPTIONAL. A provider with no key
# set is simply excluded from routing — see ai/registry.py. At least ONE
# must be set for any generation pipeline to work.
GROQ_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
NVIDIA_API_KEY=
KIMI_API_KEY=
Z_API_KEY=

# --- Per-provider overrides (optional) — base URL and default model id.
# Defaults live in ai/config.py.
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_MODEL=openai/gpt-oss-120b
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# GEMINI_MODEL=gemini-2.5-flash
# MISTRAL_BASE_URL=https://api.mistral.ai/v1
# MISTRAL_MODEL=mistral-small-latest
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
# KIMI_BASE_URL=https://api.moonshot.ai/v1
# KIMI_MODEL=kimi-k2-turbo-preview
# ZAI_BASE_URL=https://api.z.ai/api/paas/v4
# ZAI_MODEL=glm-4.6

# --- Routing policy ---
# AI_PROVIDER_PRIORITY=groq,gemini,mistral,nvidia,kimi,zai
# AI_GATEWAY_ENABLED=true

# --- Timeouts / retry / circuit breaker ---
# AI_REQUEST_TIMEOUT_SECONDS=30
# AI_CONNECT_TIMEOUT_SECONDS=10
# AI_MAX_PROVIDER_RETRIES=2
# AI_RETRY_BASE_DELAY_SECONDS=0.5
# AI_RETRY_MAX_DELAY_SECONDS=8
# AI_CIRCUIT_FAILURE_THRESHOLD=5
# AI_CIRCUIT_COOLDOWN_SECONDS=60
# AI_STRUCTURED_OUTPUT_REPAIR_RETRIES=1

# --- Application-level rate limiting (OFF by default) ---
# AI_RATE_LIMIT_ENABLED=false
# AI_RATE_LIMIT_PER_USER_PER_MINUTE=20
# AI_RATE_LIMIT_EXPENSIVE_PER_DAY=50

# --- Future: self-hosted vLLM — ignored unless both VLLM_ENABLED=true AND
# VLLM_BASE_URL are set. ---
# VLLM_ENABLED=false
# VLLM_BASE_URL=
# VLLM_API_KEY=
# VLLM_MODEL=
